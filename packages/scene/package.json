{
  "name": "@scenelock/scene",
  "version": "0.1.0",
  "description": "Scene contract types and adapter kit (snapshot / locate / settled)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/strip-scene-conformance-entry.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir ."
  },
  "dependencies": {
    "@scenelock/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "license": "MIT"
}
