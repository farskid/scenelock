{
  "name": "@scenelock/browser",
  "version": "0.1.0",
  "description": "Playwright-wrapped browser tier with a11y-primary locator policy",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir .",
    "test:real": "SCENELOCK_REAL_BROWSER=1 vitest run --config ../../vitest.config.ts ../../packages/browser/src/__tests__/real-chromium.integration.test.ts ../../packages/recorder/src/__tests__/real-chromium.integration.test.ts"
  },
  "dependencies": {
    "@scenelock/core": "workspace:*"
  },
  "peerDependencies": {
    "playwright": "^1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "^1.62.0"
  },
  "license": "MIT"
}
