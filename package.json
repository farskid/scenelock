{
  "name": "scenelock",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic UI testing framework for TS/JS — canvas-first",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm run build && tsc -p tsconfig.json --noEmit && pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
